  "item": [
    {
      "name": "Categorias",
      "item": [
        {
          "name": "01 Crear categoría",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/categorias",
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\":\"Hardware\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Tiempo de respuesta menor a 800 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(800); });",
                  "pm.test(\"JSON valido\", function () { pm.response.to.be.json; pm.expect(() => pm.response.json()).not.to.throw(); });",
                  "if (pm.response.code === 201) pm.environment.set(\"categoria_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
