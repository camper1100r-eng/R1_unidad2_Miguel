{
  "info": {
    "name": "Actividad 2 DummyJSON - plantilla de práctica",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "DummyJSON no garantiza todos los codigos 401/403/422. Para cubrir la rúbrica completa, adaptar a API del docente. La API simula escritura. Tiempo <800 ms no garantizado."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "01 Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"emilys\",\"password\":\"emilyspass\",\"expiresInMins\":30}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta recibida\", () => pm.expect(pm.response.code).to.be.oneOf([200,201,400,401,403,404,422]));",
                  "pm.test(\"Respuesta en menos de 800 ms\", () => pm.expect(pm.response.responseTime).to.be.below(800));",
                  "pm.test(\"Estado esperado 200\", () => pm.response.to.have.status(200));",
                  "if(pm.response.code===200){ let d=pm.response.json(); pm.environment.set(\"token\", d.accessToken || d.token || \"\"); }",
                  "pm.test(\"Token obtenido\", () => pm.expect(pm.environment.get(\"token\")).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Consultar usuario actual autenticado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_url}}/auth/me",
            "body": {
              "mode": "raw",
              "raw": 200,
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta recibida\", () => pm.expect(pm.response.code).to.be.oneOf([200,201,400,401,403,404,422]));",
                  "pm.test(\"Respuesta en menos de 800 ms\", () => pm.expect(pm.response.responseTime).to.be.below(800));",
                  "if(pm.response.code>=200 && pm.response.code<300) pm.test(\"JSON valido\", ()=>pm.response.to.be.json);"
                ]
              }
            }
          ]
        }
      ]
    },
